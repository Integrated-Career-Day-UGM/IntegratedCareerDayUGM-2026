# Copy to .env and fill in real values. Never commit .env.
# Astro exposes only PUBLIC_* variables to the client through import.meta.env.

# Public base URL of the site (used for sitemap, canonical URLs, site in astro.config.mjs)
# Default assumes Kiri (WSL2) local access. Change to http://localhost:4321 if you access the port directly.
PUBLIC_APP_URL=http://kiri.localhost

# YouTube video ID used by the Moments / event recap section, if any
PUBLIC_FEATURED_VIDEO_ID=

# Optional: analytics endpoint for the data-lake ready event interface.
# When set, the app will POST analytics events to this URL.
# Example: https://your-confluent-rest-proxy/topics/events
PUBLIC_ANALYTICS_ENDPOINT=

# Optional: PostHog project key and host.
# Leave empty to keep events in your own analytics queue only.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://app.posthog.com

# There is no backend at this stage (read-only site, see docs/decisions/ADR-002).
# When an API is introduced, add PUBLIC_API_URL here and validate it in src/config.

# Authoring/debug tooling for the map: GeometryEditor, GIK zoom tuner,
# window.__icd* console probes, CAM debug panel.
# `astro dev` always shows them; a deployed build shows them ONLY when this is
# "true" at build time. Set it in the STAGING build environment (Vercel ->
# Settings -> Environment Variables -> Preview). Leave unset for production —
# the tool code tree-shakes out of the bundle.
PUBLIC_DEV_TOOLS=

# MVP gate: serve only the map at "/". When "true" at build time, the landing
# page is replaced by a redirect to /map (its HTML is never generated).
# Local dev leaves it unset so the WIP landing stays previewable at /.
# Delete this variable when the landing is ready to ship.
PUBLIC_MVP_MAP_ONLY=
