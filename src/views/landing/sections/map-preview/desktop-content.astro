---
// Desktop map preview content (1440×1317 composition, card at 26,26).
---

<div class="absolute inset-0 z-10" data-name="desktop-map-preview-content">
  {/* Title */}
  <div class="absolute left-[115px] top-[79px] w-[357.882px] font-priego text-[71.312px] font-bold leading-none text-[var(--icd-ink)]">
    <p class="leading-normal">Denah</p>
    <p class="leading-normal">Interaktif</p>
  </div>

  {/* Subtitle */}
  <p class="absolute left-[795px] top-[142px] w-[542.417px] font-poppins text-[28.478px] leading-normal text-white">
    Gunakan peta interaktif untuk menemukan dream companymu!
  </p>

  {/* Map container */}
  <div class="absolute left-[99px] top-[300px] h-[806px] w-[1190.989px]" data-name="map-container">
    {/* Frame + shadow */}
    <div class="absolute left-0 top-0 h-[786.863px] w-[1190.989px] border-[19.137px] border-solid border-[#f9a395] bg-[#fafafa] shadow-[28.142px_4.503px_35.459px_0px_rgba(254,115,90,0.4)]" />

    {/* Inner clip */}
    <div class="absolute left-0 top-0 h-[786.863px] w-[1190.989px] overflow-clip">
      <div class="absolute left-0 top-0 h-[786.863px] w-[1190.989px] border-[19.137px] border-solid border-[#f9a395] bg-[#ececec] shadow-[28.142px_4.503px_35.459px_0px_rgba(254,115,90,0.4)]" />

      {/* Right-side map viewport */}
      <div class="absolute bottom-[19px] left-[523px] right-[19px] top-[19px] overflow-hidden bg-[#f4f4f4]">
        <div class="absolute inset-[67px_22px_80px]">
          <img
            alt="Peta Gelanggang Inovasi dan Kreativitas UGM"
            src="/landing/map-preview/gik-isometric.webp"
            class="block size-full object-contain"
          />
        </div>
      </div>

      {/* Legend panels */}
      <a
        href="/map/#d=gik"
        class="absolute left-0 top-0 block h-[197px] w-[523px] border-[8px] border-l-[30px] border-solid border-[var(--icd-orange)] bg-[rgba(248,248,248,0.2)]"
        aria-label="Denah Gelanggang Inovasi dan Kreativitas UGM"
      >
        <div class="absolute left-[56px] top-[21px] h-[55px] w-[151px] bg-[var(--icd-lime)]" />
        <div class="absolute left-[195px] top-[43px] h-[39px] w-[38px] bg-[var(--icd-lime)]" />
        <div class="absolute left-[66px] top-[72px] h-[55px] w-[346px] bg-[var(--icd-lime)]" />
        <div class="absolute left-[56px] top-[113px] h-[55px] w-[377px] bg-[var(--icd-lime)]" />
        <p class="absolute left-[69px] top-[26px] font-priego text-[36.129px] font-bold leading-normal text-[#fffdfd]">Denah</p>
        <div class="absolute left-[69px] top-[76px] font-priego text-[36.129px] font-bold leading-tight text-[#212121]">
          <p class="leading-normal">Gelanggang Inovasi</p>
          <p class="leading-normal">dan Kreativitas UGM</p>
        </div>
      </a>

      <a
        href="/map/#zone=expo"
        class="absolute left-0 top-[197px] block h-[197px] w-[442px] border-[8px] border-solid border-[#8c8c8c] bg-[rgba(151,151,151,0.2)]"
        aria-label="Denah Career Expo Student Center"
      >
        <div class="absolute left-[56px] top-[32px] h-[50px] w-[138px] bg-[#d6fb71]" />
        <div class="absolute left-[66px] top-[78px] h-[50px] w-[205px] bg-[#d6fb71]" />
        <div class="absolute left-[56px] top-[116px] h-[50px] w-[275px] bg-[#d6fb71]" />
        <p class="absolute left-[67.84px] top-[36.55px] font-priego text-[32.899px] font-bold leading-normal text-[#fffdfd]">Denah</p>
        <div class="absolute left-[67.84px] top-[82.08px] font-priego text-[32.899px] font-bold leading-tight text-[#585454]">
          <p class="leading-normal">Career Expo</p>
          <p class="leading-normal">(Student Center)</p>
        </div>
      </a>

      <a
        href="/map/#d=interview-counseling"
        class="absolute left-0 top-[393px] block h-[197px] w-[442px] border-[8px] border-solid border-[#8c8c8c] bg-[rgba(151,151,151,0.2)]"
        aria-label="Denah Walk-in Interview dan Career Counseling"
      >
        <div class="absolute left-[56px] top-[32px] h-[50px] w-[138px] bg-[#d6fb71]" />
        <div class="absolute left-[42px] top-[78px] h-[22px] w-[256px] bg-[#d6fb71]" />
        <div class="absolute left-[33px] top-[104px] h-[45px] w-[237px] bg-[#d6fb71]" />
        <div class="absolute left-[56px] top-[116px] h-[31px] w-[261px] bg-[#d6fb71]" />
        <p class="absolute left-[67.84px] top-[36.55px] font-priego text-[32.899px] font-bold leading-normal text-[#fffdfd]">Denah</p>
        <div class="absolute left-[56px] top-[87px] font-priego text-[25.129px] font-bold leading-tight text-[#585454]">
          <p class="leading-normal">Walk-in interview</p>
          <p class="leading-normal">& Career Counseling</p>
        </div>
        <p class="absolute left-[42px] top-[149px] font-priego text-[21.302px] font-bold leading-normal text-[#585454]">Ruang C001-002</p>
      </a>

      <a
        href="/map/#zone=walkin&company=huawei"
        class="absolute left-0 top-[590px] block h-[197px] w-[442px] border-[8px] border-solid border-[#8c8c8c] bg-[rgba(151,151,151,0.2)]"
        aria-label="Denah Walk-in Interview PT Huawei Tech"
      >
        <div class="absolute left-[56px] top-[32px] h-[50px] w-[138px] bg-[#d6fb71]" />
        <div class="absolute left-[42px] top-[78px] h-[22px] w-[256px] bg-[#d6fb71]" />
        <div class="absolute left-[33px] top-[104px] h-[45px] w-[237px] bg-[#d6fb71]" />
        <div class="absolute left-[56px] top-[116px] h-[31px] w-[261px] bg-[#d6fb71]" />
        <p class="absolute left-[67.84px] top-[36.55px] font-priego text-[32.899px] font-bold leading-normal text-[#fffdfd]">Denah</p>
        <div class="absolute left-[56px] top-[87px] font-priego text-[25.129px] font-bold leading-tight text-[#585454]">
          <p class="leading-normal">Walk-in interview</p>
          <p class="leading-normal">PT Huawei Tech</p>
        </div>
        <p class="absolute left-[42px] top-[149px] font-priego text-[21.302px] font-bold leading-normal text-[#585454]">Student Center Lt. 2</p>
      </a>

      {/* CTA */}
      <a
        href="/map/"
        aria-label="Lihat peta interaktif"
        class="figma-link absolute left-[733px] top-[707px] flex w-[458px] items-center gap-[18.135px] bg-[#161616] px-[25.11px] py-[17.914px]"
      >
        <span class="flex rotate-180 items-center justify-center">
          <img alt="" src="/landing/map-preview/union.svg" class="block size-[28.562px] max-w-none" />
        </span>
        <span class="font-priego whitespace-nowrap text-[37.899px] font-bold leading-normal text-[#e1e1e1]">
          Lihat peta interaktif
        </span>
      </a>
    </div>
  </div>
</div>
