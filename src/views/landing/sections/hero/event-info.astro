---
// Center event info: tagline, date, time, location.
---

<div
  class="-translate-x-1/2 absolute contents left-[calc(50%-0.07px)] top-[323.14px] z-20"
  data-name="event-info"
>
  {/* Decorative lime bars */}
  <div class="-translate-x-1/2 absolute flex h-[38.811px] items-center justify-center left-[calc(50%+2.65px)] top-[340.16px] w-[407.171px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] h-[38.811px] relative w-[407.171px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%-217.96px)] size-[34.044px] top-[369.44px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[34.044px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%+214.41px)] size-[19.065px] top-[323.14px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[19.065px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%+237.89px)] size-[27.916px] top-[342.2px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[27.916px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%+207.6px)] size-[13.618px] top-[372.16px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[13.618px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%-180.85px)] size-[40.172px] top-[403.48px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[40.172px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%-238.72px)] size-[26.555px] top-[350.37px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[26.555px]" />
    </div>
  </div>
  <div class="-translate-x-1/2 absolute flex items-center justify-center left-[calc(50%-208.42px)] size-[14.98px] top-[325.18px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] relative size-[14.98px]" />
    </div>
  </div>

  {/* Tagline */}
  <p
    class="-translate-x-1/2 [word-break:break-word] absolute font-priego font-bold h-[36.768px] leading-[normal] left-[722.31px] not-italic text-[var(--icd-ink)] text-[34.044px] text-center top-[338.12px] w-[433.725px]"
    data-name="tagline"
  >
    Unity Spark, Ignite Vision
  </p>

  {/* Time */}
  <div class="-translate-x-1/2 absolute flex h-[34.79px] items-center justify-center left-[calc(50%-7.07px)] top-[456.21px] w-[181.406px]">
    <div class="flex-none rotate-180">
      <div class="bg-[var(--icd-lime)] h-[34.79px] relative w-[181.406px]" />
    </div>
  </div>
  <p
    class="-translate-x-1/2 [word-break:break-word] absolute font-priego font-bold h-[31.813px] leading-[normal] left-[712.12px] not-italic text-[var(--icd-ink)] text-[29.457px] text-center top-[456.21px] w-[375.279px]"
  >
    10PM-15PM
  </p>

  {/* Date + location strip */}
  <div class="absolute h-[36.087px] left-[677.03px] top-[406.21px] w-[253.855px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src="/landing/hero/group1171276878.svg" />
  </div>
  <div class="absolute bg-[var(--icd-lime)] h-[36.087px] left-[670.85px] top-[406.21px] w-[1.244px]" />
  <div class="[word-break:break-word] absolute font-priego font-bold h-[33.363px] leading-[0] left-[566.05px] not-italic text-[20.427px] text-white top-[407.57px] w-[119.836px]">
    <p class="leading-[0.8] mb-0">November</p>
    <p class="leading-[0.8]">2026</p>
  </div>
  <div class="-translate-x-1/2 [word-break:break-word] absolute font-priego font-bold h-[33.363px] leading-[0] left-[538.13px] not-italic text-[var(--icd-teal-dark)] text-[20.427px] text-center top-[401.44px] tracking-[0.2043px] w-[54.471px] whitespace-pre-wrap">
    <p class="leading-none text-[30px] pt-[4px]">29</p>
  </div>
</div>
