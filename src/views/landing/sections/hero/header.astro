---
// Hero header bar — logos + Daftar CTA.
---

<div
  class="-translate-x-1/2 absolute content-stretch flex gap-[10px] h-[118px] items-center justify-center left-1/2 overflow-clip px-[102px] py-[24px] top-0 w-[1440px] z-20"
  data-name="header"
>
  <div
    class="bg-[rgba(95,95,95,0.5)] border border-[#8f8989] border-solid content-stretch flex gap-[317px] items-center px-[20px] py-[15px] relative rounded-[35px] shrink-0 w-[931px]"
    data-name="logo header"
  >
    <div class="content-stretch flex gap-[14px] items-center relative shrink-0" data-name="logo-header-kiri">
      <div class="grid-cols-[max-content] grid-rows-[max-content] inline-grid leading-[0] place-items-start relative shrink-0">
        <div class="col-1 grid-cols-[max-content] grid-rows-[max-content] inline-grid ml-[13.26px] mt-0 place-items-start relative row-1">
          <div class="col-1 ml-[0.46px] mt-0 relative row-1 size-[34.015px]" data-name="Vector">
            <div class="absolute inset-[-3.34%_-3.39%_-3.34%_-3.38%]">
              <img alt="" class="block max-w-none size-full" src="/landing/hero/vector.svg" />
            </div>
          </div>
          <div class="col-1 h-[34.015px] ml-0 mt-0 relative row-1 w-[34.475px]" data-name="image 43">
            <div class="absolute inset-0 overflow-hidden pointer-events-none">
              <img alt="" class="absolute h-full left-[0.7%] max-w-none top-0 w-[98.6%]" src="/landing/hero/image43.webp" />
            </div>
          </div>
        </div>
        <div class="[word-break:break-word] col-1 flex flex-col font-inter font-normal h-[14.651px] justify-end ml-0 mt-[35.86px] not-italic relative row-1 text-[3.067px] text-center text-white tracking-[-0.0613px] w-[61.393px]">
          <p class="font-inter font-semibold leading-[3.908px] mb-0">KEMENTRIAN PENDIDIKAN TINGGI, SAINS, DAN TEKNOLOGI</p>
          <p class="font-inter font-light leading-[3.908px]">REPUBLIK INDONESIA</p>
        </div>
      </div>
      <div class="grid-cols-[max-content] grid-rows-[max-content] inline-grid leading-[0] place-items-start relative shrink-0">
        <div class="col-1 h-[51.683px] ml-0 mt-0 relative row-1 w-[50.841px]" data-name="2544303660832">
          <img alt="" class="absolute block inset-0 max-w-none size-full" src="/landing/hero/2544303660832.svg" />
        </div>
      </div>
      <div class="h-[52px] relative shrink-0 w-[158px]">
        <div class="absolute contents left-[0.28px] top-[4.35px]">
          <div
            class="absolute bg-white h-[38.342px] left-[0.28px] mask-alpha mask-intersect mask-no-clip mask-no-repeat mask-size-[87.538px_38.342px] top-[4.35px] w-[87.538px]"
            style="mask-image: url('/landing/hero/image45.png')"
            data-name="image 45"
          />
        </div>
      </div>
    </div>
    <div class="content-stretch flex flex-col h-[42px] items-start py-[5px] relative shrink-0 w-[120px]" data-name="dikti">
      <div class="aspect-[1630/481] relative shrink-0 w-full" data-name="Puith_Horizontal Logo 2">
        <img alt="" class="absolute inset-0 max-w-none object-cover pointer-events-none size-full" src="/landing/hero/puith-horizontal-logo2.png" />
      </div>
    </div>
  </div>
  <a
    href="/#pendaftaran"
    aria-label="Daftar"
    class="figma-link absolute content-stretch flex flex-col items-start left-[1037px] top-[37px]"
    data-name="Button Variants"
  >
    <div class="content-stretch flex flex-col items-start relative shrink-0" data-name="btn/solid/base">
      <div class="bg-[var(--icd-lime)] content-stretch flex gap-[11.665px] items-end justify-center px-[20.747px] py-[14.264px] relative rounded-[116.651px] shrink-0" data-name="btn/base">
        <div class="flex items-center justify-center relative shrink-0">
          <div class="flex-none rotate-180">
            <div class="relative size-[15.561px]" data-name="Union">
              <img alt="" class="absolute block inset-0 max-w-none size-full" src="/landing/hero/union.svg" />
            </div>
          </div>
        </div>
        <div class="content-stretch flex gap-[12.174px] items-center relative shrink-0" data-name="Elements">
          <p class="[word-break:break-word] font-inter font-semibold leading-[18.261px] not-italic relative shrink-0 text-[var(--icd-ink)] text-[18.261px] whitespace-nowrap">
            Daftar
          </p>
        </div>
      </div>
    </div>
  </a>
</div>
