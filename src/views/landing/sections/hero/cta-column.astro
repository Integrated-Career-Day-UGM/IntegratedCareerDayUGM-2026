---
// Hero CTA column: Info Pendaftaran, Denah Lokasi (/map), Company Presentation Rundown.
---

<div
  class="absolute content-stretch flex flex-col gap-[18px] items-start left-[583px] top-[557px] w-[259.508px] z-20"
  data-name="cta-column"
>
  <a
    href="/#pendaftaran"
    aria-label="Info Pendaftaran"
    class="figma-link bg-[#f5f5f5] content-stretch flex gap-[11.857px] items-center px-[16.417px] py-[5.472px] relative shrink-0 w-full"
    data-name="CTA"
  >
    <div class="flex items-center justify-center relative shrink-0">
      <div class="flex-none rotate-180">
        <div class="relative size-[18.673px]" data-name="Union">
          <div class="absolute inset-[-4.17%]">
            <img alt="" class="block max-w-none size-full" src="/landing/hero/union4.svg" />
          </div>
        </div>
      </div>
    </div>
    <p class="[word-break:break-word] font-priego font-bold leading-[normal] not-italic relative shrink-0 text-[var(--icd-ink)] text-[24.778px] whitespace-nowrap">
      Info Pendaftaran
    </p>
  </a>

  <a
    href="/map"
    aria-label="Denah Lokasi"
    class="figma-link bg-[#f5f5f5] content-stretch flex gap-[11.857px] items-center px-[16.417px] py-[5.472px] relative shrink-0 w-full"
    data-name="CTA"
  >
    <div class="flex items-center justify-center relative shrink-0">
      <div class="flex-none rotate-180">
        <div class="relative size-[18.673px]" data-name="Union">
          <div class="absolute inset-[-4.17%]">
            <img alt="" class="block max-w-none size-full" src="/landing/hero/union5.svg" />
          </div>
        </div>
      </div>
    </div>
    <p class="[word-break:break-word] font-priego font-bold leading-[normal] not-italic relative shrink-0 text-[var(--icd-ink)] text-[24.778px] whitespace-nowrap">Denah Lokasi</p>
  </a>

  <a
    href="/#rundown"
    aria-label="Company Presentation Rundown"
    class="figma-link bg-[#f5f5f5] content-stretch flex gap-[11.857px] items-center px-[16.417px] py-[5.472px] relative shrink-0 w-full"
    data-name="CTA"
  >
    <div class="flex items-center justify-center relative shrink-0">
      <div class="flex-none rotate-180">
        <div class="relative size-[18.673px]" data-name="Union">
          <div class="absolute inset-[-4.17%]">
            <img alt="" class="block max-w-none size-full" src="/landing/hero/union6.svg" />
          </div>
        </div>
      </div>
    </div>
    <div class="[word-break:break-word] font-priego font-bold leading-[0] not-italic relative shrink-0 text-[var(--icd-ink)] text-[18.661px] whitespace-nowrap">
      <p class="leading-[normal] mb-0 whitespace-pre">Company Presentation </p>
      <p class="leading-[normal] whitespace-pre">Rundown</p>
    </div>
  </a>
</div>
