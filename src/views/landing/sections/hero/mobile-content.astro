---
// Mobile hero content layer (390px Figma frame).
---

<div class="relative z-10 flex flex-col items-center gap-[80px] pb-[152px] pt-[36px] px-4" data-name="mobile-hero-content">
  {/* Header */}
  <div class="w-full flex items-center justify-between gap-2" data-name="mobile-header">
    <div class="flex items-center gap-2">
      <img alt="" src="/landing/hero/vector.svg" class="w-6 h-6" />
      <img alt="" src="/landing/hero/2544303660832.svg" class="w-7 h-7" />
      <img alt="" src="/landing/hero/puith-horizontal-logo2.png" class="h-6 w-auto" />
    </div>
    <a
      href="/#pendaftaran"
      class="figma-link bg-[var(--icd-lime)] flex items-center gap-2 px-4 py-2 rounded-full"
    >
      <img alt="" src="/landing/hero/union.svg" class="w-4 h-4 rotate-180" />
      <span class="font-inter font-semibold text-[var(--icd-ink)] text-sm">Daftar</span>
    </a>
  </div>

  {/* Title lockup */}
  <div class="relative w-full flex flex-col items-center" data-name="mobile-title">
    <img alt="" src="/landing/hero/ugm.svg" class="w-[220px] h-auto" />
    <h1 class="font-priego font-bold text-white text-[36px] leading-tight tracking-wide text-center mt-1">
      Integrated<br />Career Days
    </h1>
    <div class="relative mt-2">
      <img alt="" src="/landing/hero/subtract.svg" class="w-[180px] h-auto" />
      <span class="absolute left-2 top-1/2 -translate-y-1/2 font-priego font-bold text-[var(--icd-ink)] text-lg">NOVEMBER 2026</span>
    </div>
  </div>

  {/* Tagline + event info */}
  <div class="relative w-full flex flex-col items-center gap-4" data-name="mobile-event-info">
    <p class="font-priego font-bold text-[var(--icd-ink)] text-2xl text-center bg-[var(--icd-lime)] px-3 py-1">
      Unity Spark, Ignite Vision
    </p>

    <div class="flex items-center gap-2 bg-[var(--icd-lime)] px-3 py-1">
      <span class="font-priego font-bold text-[var(--icd-teal-dark)] text-2xl">28<br />29</span>
      <div class="flex flex-col text-[var(--icd-ink)] font-priego font-bold text-sm leading-tight">
        <span>November</span>
        <span>2026</span>
      </div>
      <div class="w-px h-8 bg-[var(--icd-lime)]" />
      <div class="flex flex-col text-[var(--icd-ink)] font-priego font-bold text-sm leading-tight">
        <span>GIK</span>
        <span class="text-xs font-normal">Gelanggang Inovasi<br />dan Kreativitas UGM</span>
      </div>
    </div>

    <p class="font-priego font-bold text-[var(--icd-ink)] text-lg bg-[var(--icd-lime)] px-4 py-1">
      10PM-15PM
    </p>
  </div>

  {/* CTA column */}
  <div class="w-full max-w-[320px] flex flex-col gap-3" data-name="mobile-cta">
    <a href="/#pendaftaran" class="figma-link bg-[#f5f5f5] flex items-center gap-3 px-4 py-3 w-full">
      <img alt="" src="/landing/hero/union4.svg" class="w-5 h-5 rotate-180" />
      <span class="font-priego font-bold text-[var(--icd-ink)] text-lg">Info Pendaftaran</span>
    </a>
    <a href="/map" class="figma-link bg-[#f5f5f5] flex items-center gap-3 px-4 py-3 w-full">
      <img alt="" src="/landing/hero/union5.svg" class="w-5 h-5 rotate-180" />
      <span class="font-priego font-bold text-[var(--icd-ink)] text-lg">Denah Lokasi</span>
    </a>
    <a href="/#rundown" class="figma-link bg-[#f5f5f5] flex items-center gap-3 px-4 py-3 w-full">
      <img alt="" src="/landing/hero/union6.svg" class="w-5 h-5 rotate-180" />
      <span class="font-priego font-bold text-[var(--icd-ink)] text-lg">Company Presentation<br />Rundown</span>
    </a>
  </div>
</div>
