---
// "What's Inside?" bento section (Figma node 1487:19831 mobile / 1484:22589 desktop).
// Dark cards use the Figma radial-gradient fill; Walk-in and Games use the
// original photo fills. Career Expo uses a scroll-driven logo marquee.
import CareerExpoMarquee from './bento/CareerExpoMarquee.tsx';
import { careerExpoColumns } from './bento/logos';

const card = 'bento-card-bg group relative flex flex-col overflow-hidden rounded-[15px] border-[2.5px] border-[#393939] text-white md:rounded-[18px] md:border-[3px] transition-transform duration-300 hover:-translate-y-1';
const cta = 'flex w-fit items-center gap-2 bg-[#f5f5f5] px-3 py-1.5 font-priego text-[13px] font-bold leading-normal text-[var(--icd-ink)] md:px-4 md:py-2 md:text-[14px]';
---

<section class="bento-section relative w-full overflow-clip bg-[#0f0f0f] px-12 py-12 sm:px-8 sm:py-16" data-name="What's Inside Bento" id="kegiatan">
  <div class="relative mx-auto flex w-full max-w-[1200px] flex-col gap-6 md:gap-8">
    <h2
      class="relative mx-auto w-fit font-priego text-center text-[30px] font-bold leading-tight text-white md:text-[48px]"
      style={{ WebkitTextStroke: '2px #0f0f0f', paintOrder: 'stroke fill' }}
    >
      What’s Inside?
    </h2>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-5">
      {/* Walk-in Interview */}
      <a
        href="/map/#zone=walkin"
        class:list={[card, 'col-span-2 min-h-[328px] md:col-span-1 md:col-start-1 md:row-span-2 md:row-start-1 md:min-h-[420px]']}
      >
        <img
          src="/landing/activities/nin017451.webp"
          alt=""
          class="absolute inset-0 size-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-black/10" />
        <div class="relative mt-auto flex flex-col gap-3 p-6">
          <h3 class="font-priego text-[26px] font-bold leading-tight">Walk-in Interview</h3>
          <span class={cta}>
            <img src="/landing/activities/union5.svg" alt="" class="size-4 rotate-180" />
            Lihat Selengkapnya
          </span>
        </div>
      </a>

      {/* Career Counseling */}
      <a
        href="/map/#zone=counseling"
        class:list={[card, 'col-span-1 min-h-[140px] p-4 md:col-start-2 md:row-start-1 md:min-h-[201px] md:p-6']}
      >
        <h3 class="font-priego text-[20px] font-bold leading-tight md:text-[24px]">Career Counseling</h3>
        <span class:list={[cta, 'mt-3']}>
          <img src="/landing/activities/union4.svg" alt="" class="size-4 rotate-180" />
          Lihat Detail
        </span>
        <div class="pointer-events-none absolute -bottom-3 -right-2 w-[64px] rotate-[-4.72deg] md:-bottom-5 md:-right-3 md:w-[92px]">
          <img src="/landing/activities/group1171276976.svg" alt="" class="w-full" />
          <img src="/landing/activities/group1171276978.svg" alt="" class="absolute left-[7%] top-[7%] w-[86%]" />
        </div>
      </a>

      {/* Games */}
      <a
        href="/map/#zone=games"
        class:list={[card, 'col-span-1 min-h-[140px] md:col-start-3 md:row-start-1 md:min-h-[201px]']}
      >
        <img
          src="/landing/activities/icd661.webp"
          alt=""
          class="absolute inset-0 size-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent" />
        <img
          src="/landing/activities/group1171276998.svg"
          alt=""
          class="absolute left-1/2 top-4 w-7 -translate-x-1/2 md:top-6 md:w-9"
        />
        <div class="relative mt-auto flex flex-col items-center gap-1.5 p-3 md:gap-2 md:p-4">
          <h3 class="font-priego text-[20px] font-bold md:text-[24px]">Games</h3>
          <span class="bg-[#d9ff73] px-2.5 py-0.5 font-priego text-[12px] font-bold italic text-[var(--icd-ink)] md:px-3 md:text-[14px]">
            Nextverse
          </span>
        </div>
      </a>

      {/* Motion+ */}
      <a
        href="/map/#zone=games"
        class:list={[card, 'col-span-1 min-h-[140px] p-4 md:col-start-4 md:row-start-2 md:min-h-[201px] md:p-6']}
      >
        <h3 class="font-priego text-[20px] font-bold leading-tight md:text-[24px]">Motion+</h3>
        <div class="relative -mb-2 mt-auto flex flex-1 items-center justify-center">
          <div class="relative w-[52px] md:w-[74px]">
            <img src="/landing/activities/group1171276979.svg" alt="" class="w-full" />
            <img src="/landing/activities/group1171276980.svg" alt="" class="absolute left-[7%] top-[7%] w-[86%]" />
          </div>
        </div>
      </a>

      {/* Display Experience */}
      <a
        href="/map/#zone=games"
        class:list={[card, 'col-span-1 min-h-[140px] p-4 md:col-start-5 md:row-start-2 md:min-h-[201px] md:p-6']}
      >
        <h3 class="font-priego text-[20px] font-bold leading-tight md:text-[24px]">Display Experience</h3>
        <div class="relative -mb-2 mt-auto flex flex-1 items-center justify-center">
          <div class="relative w-[46px] md:w-[62px]">
            <img src="/landing/activities/group1171276982.svg" alt="" class="w-full" />
            <img src="/landing/activities/group1171276981.svg" alt="" class="absolute left-[9%] top-[9%] w-[82%]" />
          </div>
        </div>
      </a>

      {/* Company Presentation */}
      <a
        href="/#rundown"
        class:list={[card, 'col-span-2 min-h-[150px] p-4 md:col-span-2 md:col-start-4 md:row-start-1 md:min-h-[201px] md:p-6']}
      >
        <div class="pointer-events-none absolute -right-1 top-3 h-[108px] w-[96px] rotate-[4.61deg] overflow-hidden rounded-[5px] bg-[#ebebeb] md:-right-2 md:top-4 md:h-[132px] md:w-[120px]">
          <div
            class="absolute inset-0 bg-[#ff5a88]"
            style={{
              maskImage: "url('/landing/activities/rectangle2.svg')",
              WebkitMaskImage: "url('/landing/activities/rectangle2.svg')",
              maskSize: '82px 82px',
              WebkitMaskSize: '82px 82px',
              maskRepeat: 'no-repeat',
              WebkitMaskRepeat: 'no-repeat',
              maskPosition: '8px -2px',
            }}
          />
          <img src="/landing/activities/subtract.svg" alt="" class="absolute inset-x-0 bottom-0 w-full" />
          <img src="/landing/activities/group1171276908.svg" alt="" class="absolute left-2 top-2 w-[58px] md:w-[74px]" />
          <img src="/landing/activities/group1171276909.svg" alt="" class="absolute left-3 top-4 w-[50px] md:w-[64px]" />
          <img src="/landing/activities/group1171276911.svg" alt="" class="absolute left-1 top-7 w-[68px] md:top-8 md:w-[86px]" />
          <img src="/landing/activities/group1171276910.svg" alt="" class="absolute left-2 top-9 w-[60px] md:top-10 md:w-[78px]" />
          <span class="absolute -top-2 left-1 bg-[#101010] px-1.5 py-0.5 font-priego text-[9px] font-bold text-white md:px-2 md:text-[10px]">
            Booth Code B
          </span>
        </div>
        <div class="relative max-w-[62%]">
          <h3 class="font-priego text-[20px] font-bold leading-tight md:text-[24px]">Company Presentation</h3>
          <p class="mt-1 font-poppins text-[11px] leading-snug text-white/75 md:text-[13px]">
            Lihat jadwal presentasi
          </p>
          <span class:list={[cta, 'mt-3']}>
            <img src="/landing/activities/union4.svg" alt="" class="size-4 rotate-180" />
            Rundown
          </span>
        </div>
      </a>

      {/* Career Expo */}
      <a
        href="/map/#zone=expo"
        class:list={[card, 'col-span-2 min-h-[180px] p-4 md:col-span-2 md:col-start-2 md:row-start-2 md:min-h-[201px] md:p-6']}
      >
        <h3 class="font-priego text-[20px] font-bold leading-tight md:text-[24px]">Career Expo</h3>
        <div class="relative mt-2 h-[120px] w-full overflow-hidden md:mt-3 md:h-[150px]">
          <CareerExpoMarquee columns={careerExpoColumns} client:visible />
          <img
            src="/landing/activities/union3.svg"
            alt=""
            class="pointer-events-none absolute -bottom-2 -left-2 w-[48px] rotate-[14.41deg] md:-left-3 md:w-[68px]"
          />
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  /* Figma card fill: radial gradient rather than a flat black. */
  .bento-card-bg {
    background-color: #1d1d1f;
    background-image: radial-gradient(
      ellipse 75% 75% at 50% 62%,
      rgba(29, 29, 31, 1) 22%,
      rgba(39, 39, 40, 0.914) 73%,
      rgba(54, 54, 54, 0.8) 100%
    );
  }
</style>
