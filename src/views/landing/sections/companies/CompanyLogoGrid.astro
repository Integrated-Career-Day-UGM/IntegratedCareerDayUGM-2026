---
// Folder-based company logo grid.
// Drop logo files into /public/landing/companies/logos/ and they render here.
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const logosDir = join(process.cwd(), 'public', 'landing', 'companies', 'logos');
const files = readdirSync(logosDir, { withFileTypes: true })
  .filter((d) => d.isFile() && /\.(png|jpe?g|webp|svg|gif)$/i.test(d.name))
  .map((d) => ({
    src: `/landing/companies/logos/${d.name}`,
    alt: d.name.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' '),
  }));
---

<div class={className} data-name="company-logo-grid">
  {files.map((logo) => (
    <div class="flex aspect-[3/2] w-full items-center justify-center rounded-xl bg-white p-2 shadow-sm">
      <img
        src={logo.src}
        alt={logo.alt}
        class="max-h-full max-w-full object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
</div>
