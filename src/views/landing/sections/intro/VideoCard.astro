---
// Video thumbnail card with play button overlay.
interface Props {
  variant?: 'desktop' | 'mobile';
  buttonSrc?: string;
}

const { variant = 'desktop', buttonSrc = '/landing/intro/button-base.svg' } = Astro.props;
const isDesktop = variant === 'desktop';
---

<div class={`relative shrink-0 overflow-hidden ${isDesktop ? 'h-[242px] w-[388px]' : 'h-[180px] w-full'}`} data-name="video-card">
  {/* Frame / border */}
  <img alt="" src="/landing/intro/cta.png" class="pointer-events-none absolute inset-0 block size-full max-w-none object-cover" />

  {/* Video thumbnail */}
  <div class={`absolute overflow-hidden pointer-events-none ${isDesktop ? 'left-[-20px] top-0 h-[321px] w-[482px]' : 'inset-0'}`}>
    <img alt="" src="/landing/intro/kaf00917.webp" class="absolute left-0 top-0 h-full w-full max-w-none object-cover" />
  </div>

  {/* Play button */}
  <div class={`absolute ${isDesktop ? 'left-[154px] top-[80px] h-[81.725px] w-[81px]' : 'left-1/2 top-1/2 h-[60px] w-[60px] -translate-x-1/2 -translate-y-1/2'}`}>
    <img alt="Play" src={buttonSrc} class="absolute inset-0 block size-full max-w-none" />
  </div>
</div>
