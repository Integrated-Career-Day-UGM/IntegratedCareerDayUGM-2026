---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapSidebar from '../islands/map/MapSidebar';
import MapLibreMap from '../islands/map/MapLibreMap';
import TrackSwitcher from '../islands/map/TrackSwitcher';
import QuickFind from '../islands/map/QuickFind';
import MobileBottomSheet from '../islands/map/MobileBottomSheet';
import MobileLayoutTuner from '../islands/map/MobileLayoutTuner';
import GeometryEditor from '../islands/map/GeometryEditor';
import RegisterLinks from '../islands/map/RegisterLinks';
import MapSplash from '../islands/map/MapSplash';
import BrandLockup from '../components/map/BrandLockup';
import { event, ui } from '../lib/data';
import '../styles/base/global.css';

const eventStartDate = event.days[0]?.date ?? '2026-11-28';
const eventEndDate = event.days.at(-1)?.date ?? '2026-11-29';
const canonicalUrl = new URL(
  '/map',
  Astro.site ?? 'https://www.icdugm26.app',
).href;

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${event.name} 2026`,
  startDate: `${eventStartDate}T10:00:00+07:00`,
  endDate: `${eventEndDate}T15:00:00+07:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: canonicalUrl,
  location: {
    '@type': 'Place',
    name: 'Gedung Industri Kreatif (GIK) UGM',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Yogyakarta',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title="Integrated Career Day Nov 2026 Map | UGM ICD"
  canonicalPath="/map"
  robots="index, follow, max-image-preview:large"
  openGraph
  siteName="UGM Integrated Career Days"
  jsonLd={eventJsonLd}
>
  <main class="app-viewport fixed inset-x-0 top-0 flex overflow-hidden bg-[#09090b]">
    {/* Server-rendered crawlable context. Most of the map UI is client:only,
        so search engines otherwise receive almost no event content. */}
    <section class="sr-only" aria-labelledby="map-seo-heading">
      <h1 id="map-seo-heading">Peta Interaktif UGM Integrated Career Days 2026</h1>
      <p>
        28–29 November 2026 di Gedung Industri Kreatif (GIK) UGM, Yogyakarta.
        Career Expo di Student Center Lt 1, Walk-in Interview di Student Center Lt 2,
        dan Counseling di PP KAGAMA Booth B. Event berlangsung 10:00–15:00 WIB.
      </p>
    </section>
    {/* Desktop sidebar — narrower step at md (360px) widening to 390px at
        lg, so 768–1023px screens keep more map (§6). */}
    <aside class="hidden h-full w-[400px] shrink-0 border-r border-[#2a2a2a] md:flex lg:w-[430px]">
      {/* Server-rendered skeleton so the sidebar is never a black void before
          the client-only island hydrates. MapSidebar removes it on mount. */}
      <div id="sidebar-boot" class="flex h-full w-full" aria-hidden="true">
        <div class="flex w-14 shrink-0 flex-col items-center gap-2 border-r border-[#2a2a2a] bg-[#1d1d1d] pt-14">
          <div class="size-8 skeleton-shimmer"></div>
          <div class="size-8 skeleton-shimmer"></div>
          <div class="size-8 skeleton-shimmer"></div>
          <div class="size-8 skeleton-shimmer"></div>
        </div>
        <div class="min-w-0 flex-1 bg-[#1d1d1d]">
          <div class="h-[150px] border-b border-[#232326] p-5">
            <div class="h-4 w-28 skeleton-shimmer"></div>
            <div class="mt-7 h-10 w-52 skeleton-shimmer"></div>
          </div>
          <div class="px-4 pt-4">
            <div class="h-[42px] w-full rounded-2xl skeleton-shimmer"></div>
            <div class="mt-4 h-[280px] w-full rounded-md border border-[#2a2a2a] bg-[#141416] p-3">
              <div class="h-4 w-24 skeleton-shimmer"></div>
              <div class="mt-3 h-10 w-full skeleton-shimmer"></div>
              <div class="mt-2 h-10 w-5/6 skeleton-shimmer"></div>
              <div class="mt-4 h-28 w-full skeleton-shimmer"></div>
            </div>
          </div>
        </div>
      </div>
      <MapSidebar client:only="react" />
    </aside>

    {/* Map area */}
    <section class="relative flex h-full min-w-0 flex-1 flex-col">
      {/* Top chrome — mobile: search → [track tabs + brand] → quick find.
          Desktop keeps search in the sidebar and the track bar as its own row. */}
      <div id="map-chrome" class="pointer-events-none absolute inset-x-0 top-0 z-30 flex flex-col items-start gap-2 p-3 md:p-4">
        {/* Mobile search lives in the Search tab of the bottom sheet; the map
            stays clean by default. */}

        {/* Track switcher (island owns its bar chrome) — desktop top bar. */}
        <div class="pointer-events-auto hidden max-w-full md:block">
          <TrackSwitcher client:only="react" />
        </div>

        {/* Mobile track row: tabs take the free width, brand art sits top
            right on the same baseline. Real flex layout — no scale probe. */}
        <div class="flex w-full items-start justify-between gap-2 md:hidden">
          <div
            data-layout-tune="track-switcher"
            class="pointer-events-auto min-w-0 flex-1"
          >
            <TrackSwitcher client:only="react" />
          </div>
          <div data-layout-tune="brand-lockup" class="pointer-events-none shrink-0 pt-1">
            <BrandLockup compact />
          </div>
        </div>

        {/* Quick find — directly under the track row on mobile; under the
            track switcher on desktop. */}
        <div data-layout-tune="quick-find" class="pointer-events-auto">
          <QuickFind client:only="react" />
        </div>
      </div>

      {/* Desktop open-hours badge — top-right of the map viewport. */}
      <div
        data-layout-tune="open-hours-desktop"
        class="pointer-events-none absolute right-3 top-3 z-30 hidden flex-col items-end md:flex md:right-4 md:top-4"
      >
        <span class="bg-white px-2.5 py-1.5 font-heading text-[0.875rem] font-bold uppercase leading-none tracking-[0.04em] text-black">
          {ui.info.sections.hours.headline}
        </span>
        <span class="h-[2px] w-full bg-white"></span>
      </div>

      {/* Registration — outside the sidebar, desktop only. Bottom-right
          keeps it clear of the track switcher, zoom rail and hall card. */}
      <div class="pointer-events-none absolute bottom-8 right-4 z-10 hidden md:block">
        <div class="pointer-events-auto">
          <RegisterLinks client:only="react" />
        </div>
      </div>

      {/* Mobile bottom sheet — above the map chrome so QuickFind never
          paints over an open tray. `data-tray-root` is the DEV typography
          picker scope. */}
      <div
        data-tray-root
        class="absolute inset-x-0 bottom-0 z-40 h-auto md:hidden"
      >
        <MobileBottomSheet client:only="react" />
      </div>

      <div class="h-full w-full">
        <MapLibreMap client:only="react" />
      </div>

      {/* Figma splash (node 2038:25543) → PixelTransition reveal. Rendered
          with client:load so the splash is in the first HTML paint. */}
      <MapSplash client:load />

      {/* DEV-only mobile layout tuner (drag + scale + copy values). */}
      {import.meta.env.DEV && <MobileLayoutTuner client:only="react" />}
      {/* DEV-only frame geometry editor (booths, fixtures, Career Star/Counseling labels). */}
      {import.meta.env.DEV && <GeometryEditor client:only="react" />}

      <script is:inline>
        window.addEventListener('icd:splash-done', function () {
          const chrome = document.getElementById('map-chrome');
          if (chrome) chrome.classList.add('reveal-items');
        });
      </script>
    </section>
  </main>

  {/* Vercel Web Analytics — map page only; the shared layout stays untouched. */}
  <Analytics />

  {/* Vercel Speed Insights — map page only, rendered last in the document. */}
  <SpeedInsights />
</BaseLayout>
