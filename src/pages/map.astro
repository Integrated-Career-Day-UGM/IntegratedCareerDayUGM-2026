---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapSidebar from '../islands/map/MapSidebar';
import MapLibreMap from '../islands/map/MapLibreMap';
import TrackSwitcher from '../islands/map/TrackSwitcher';
import QuickFind from '../islands/map/QuickFind';
import MobileBottomSheet from '../islands/map/MobileBottomSheet';
import MobileLayoutTuner from '../islands/map/MobileLayoutTuner';
import GeometryEditor from '../islands/map/GeometryEditor';
import GeoJsonEditor from '../islands/map/GeoJsonEditor';
import RegisterLinks from '../islands/map/RegisterLinks';
import MapSplash from '../islands/map/MapSplash';
import MatchingTrigger from '../islands/matching/MatchingTrigger';
import MatchingModal from '../islands/matching/MatchingModal';
import MobileDayPicker from '../islands/map/MobileDayPicker';
import BrandLockup from '../components/map/BrandLockup';
import { event, ui } from '../lib/data';
import '../styles/base/global.css';

const eventStartDate = event.days[0]?.date ?? '2026-11-28';
const eventEndDate = event.days.at(-1)?.date ?? '2026-11-29';
const canonicalUrl = new URL('/map', Astro.site ?? 'https://www.icdugm26.app').href;

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${event.name} 2026`,
  startDate: `${eventStartDate}T10:00:00+07:00`,
  endDate: `${eventEndDate}T15:00:00+07:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: canonicalUrl,
  location: {
    '@type': 'Place',
    name: 'Gedung Industri Kreatif (GIK) UGM',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Yogyakarta',
      addressCountry: 'ID',
    },
  },
};
---

<BaseLayout
  title="Integrated Career Day Nov 2026 Map | UGM ICD"
  canonicalPath="/map"
  robots="index, follow, max-image-preview:large"
  openGraph
  siteName="UGM Integrated Career Days"
  jsonLd={eventJsonLd}
>
  <main class="app-viewport fixed inset-x-0 top-0 flex overflow-hidden bg-[#09090b]">
    {
      /* Server-rendered crawlable context. Most of the map UI is client:only,
        so search engines otherwise receive almost no event content. */
    }
    <section class="sr-only" aria-labelledby="map-seo-heading">
      <h1 id="map-seo-heading">Peta Interaktif UGM Integrated Career Days 2026</h1>
      <p>
        28–29 November 2026 di Gedung Industri Kreatif (GIK) UGM, Yogyakarta. Career Expo di Student
        Center Lt 1, Walk-in Interview di Student Center Lt 2, dan Counseling di PP KAGAMA Booth B.
        Event berlangsung 10:00–15:00 WIB.
      </p>
    </section>
    {
      /* Tablet/desktop sidebar — 360px for the whole tablet range (768–1023)
        so the map keeps room, widening to 430px at lg. */
    }
    <aside class="hidden h-full w-[360px] shrink-0 border-r border-[#2a2a2a] md:flex lg:w-[430px]">
      {
        /* Server-rendered skeleton so the sidebar is never a black void before
          the client-only island hydrates. MapSidebar removes it on mount. */
      }
      <div id="sidebar-boot" class="flex h-full w-full" aria-hidden="true">
        <div
          class="flex w-14 shrink-0 flex-col items-center gap-2 border-r border-[#2a2a2a] bg-[#1d1d1d] pt-14"
        >
          <div class="skeleton-shimmer size-8"></div>
          <div class="skeleton-shimmer size-8"></div>
          <div class="skeleton-shimmer size-8"></div>
          <div class="skeleton-shimmer size-8"></div>
        </div>
        <div class="min-w-0 flex-1 bg-[#1d1d1d]">
          <div class="h-[150px] border-b border-[#232326] p-5">
            <div class="skeleton-shimmer h-4 w-28"></div>
            <div class="skeleton-shimmer mt-7 h-10 w-52"></div>
          </div>
          <div class="px-4 pt-4">
            <div class="skeleton-shimmer h-[42px] w-full rounded-2xl"></div>
            <div class="mt-4 h-[280px] w-full rounded-md border border-[#2a2a2a] bg-[#141416] p-3">
              <div class="skeleton-shimmer h-4 w-24"></div>
              <div class="skeleton-shimmer mt-3 h-10 w-full"></div>
              <div class="skeleton-shimmer mt-2 h-10 w-5/6"></div>
              <div class="skeleton-shimmer mt-4 h-28 w-full"></div>
            </div>
          </div>
        </div>
      </div>
      <MapSidebar client:only="react" />
    </aside>

    {/* Map area */}
    <section class="relative flex h-full min-w-0 flex-1 flex-col">
      {
        /* Top chrome — mobile: search → [track tabs + brand] → quick find.
          Desktop keeps search in the sidebar and the track bar as its own row. */
      }
      <div
        id="map-chrome"
        class="pointer-events-none absolute inset-x-0 top-0 z-30 flex flex-col items-start gap-2 p-3 lg:p-4"
      >
        {
          /* Mobile search lives in the Search tab of the bottom sheet; the map
            stays clean by default. */
        }

        {/* Track switcher (island owns its bar chrome) — desktop top bar. */}
        <div class="pointer-events-auto hidden max-w-full lg:block">
          <TrackSwitcher client:only="react" />
        </div>

        {
          /* Mobile: tabs and QuickFind/Job Matcher share one left column, so
            the tall brand art on the right can never push them apart. The
            column's own gap is the whole spacing budget. */
        }
        <div class="flex w-full items-start justify-between gap-2 lg:hidden">
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <div data-layout-tune="track-switcher" class="pointer-events-auto min-h-[42px]">
              <TrackSwitcher client:only="react" />
            </div>
            <div class="pointer-events-auto flex items-stretch gap-3 py-4">
              <div data-layout-tune="quick-find" class="pointer-events-auto h-11 w-11 shrink-0">
                <QuickFind client:only="react" />
              </div>
              <div class="pointer-events-auto shrink-0">
                <MatchingTrigger client:idle />
              </div>
            </div>
          </div>
          <div
            data-layout-tune="brand-lockup"
            class="pointer-events-none flex shrink-0 flex-col items-end gap-1.5 pt-1 md:hidden"
          >
            <BrandLockup compact />
            <div class="pointer-events-auto size-10">
              <MobileDayPicker client:idle />
            </div>
          </div>
        </div>

        {
          /* Desktop: track bar then the QuickFind row. Mobile has its own copy
            nested in the row above, so breakpoints never share a layout. */
        }
        <div class="pointer-events-auto hidden items-start gap-2 lg:flex lg:flex-col">
          <div class="pointer-events-auto">
            <QuickFind client:only="react" />
          </div>
          <div class="pointer-events-auto">
            <MatchingTrigger client:idle />
          </div>
        </div>
      </div>

      {/* Desktop open-hours badge — top-right of the map viewport. */}
      <div
        data-layout-tune="open-hours-desktop"
        class="pointer-events-none absolute top-3 right-3 z-30 hidden flex-col items-end lg:top-4 lg:right-4 lg:flex"
      >
        <span
          class="font-heading bg-white px-2.5 py-1.5 text-[0.875rem] leading-none font-bold tracking-[0.04em] text-black uppercase"
        >
          {ui.info.sections.hours.headline}
        </span>
        <span class="h-[2px] w-full bg-white"></span>
      </div>

      {
        /* Registration — outside the sidebar, desktop only. Bottom-right
          keeps it clear of the track switcher, zoom rail and hall card. */
      }
      <div class="pointer-events-none absolute right-4 bottom-8 z-10 hidden lg:block">
        <div class="pointer-events-auto">
          <RegisterLinks client:only="react" />
        </div>
      </div>

      {
        /* Mobile bottom sheet — above the map chrome so QuickFind never
          paints over an open tray. `data-tray-root` is the DEV typography
          picker scope. */
      }
      <div data-tray-root class="absolute inset-x-0 bottom-0 z-40 h-auto md:hidden">
        <MobileBottomSheet client:only="react" />
      </div>

      <div class="h-full w-full">
        <MapLibreMap client:only="react" />
      </div>

      {
        /* Figma splash (node 2038:25543) → PixelTransition reveal. Rendered
          with client:load so the splash is in the first HTML paint. */
      }
      <MapSplash client:load />

      {/* Career matching sidecar — decoupled islands, engine loads on open. */}
      <MatchingModal client:idle />

      {/* DEV-only mobile layout tuner (drag + scale + copy values). */}
      {import.meta.env.DEV && <MobileLayoutTuner client:only="react" />}
      {/* DEV-only frame geometry editor (booths, fixtures, Career Star/Counseling labels). */}
      {import.meta.env.DEV && <GeometryEditor client:only="react" />}
      {/* DEV-only GeoJSON debug for the decoupled basemap site geometry. */}
      {import.meta.env.DEV && <GeoJsonEditor client:only="react" />}

      <script is:inline>
        window.addEventListener('icd:splash-done', function () {
          const chrome = document.getElementById('map-chrome');
          if (chrome) chrome.classList.add('reveal-items');
        });
      </script>
    </section>
  </main>

  {/* Vercel Web Analytics — map page only; the shared layout stays untouched. */}
  <Analytics />

  {/* Vercel Speed Insights — map page only, rendered last in the document. */}
  <SpeedInsights />
</BaseLayout>
