# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This repo has two goals for this file:
#   1. Keep generated tool output (builds, caches, logs, reports) out of git.
#   2. Stop CLI tools and AI agents from littering the repository root.
#      Fluid Functionalism (`npx fluidfunctionalism`) writes kit files to the
#      working directory root; those patterns are blocked at the bottom so the
#      litter never gets committed by accident. Kit code belongs in
#      src/lib, src/hooks, and src/components/ui.

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.pnpm-store/

# ---------- Build output ----------
dist/
out/
build/
.astro/
*.tsbuildinfo

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Test & coverage artifacts ----------
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
*.lcov

# ---------- Caches & platform state ----------
.cache/
.eslintcache
.stylelintcache
.turbo/
.vercel/
.netlify/
.wrangler/

# ---------- OS & editor noise ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*~
.vscode/
.idea/
*.code-workspace

# ---------- AI agent workspaces (local, never committed) ----------
.agents/
.codex/
.impeccable/
.claude/
.cursor/
.aider*
.continue/
.windsurf/
.codeium/
.github/skills/
.github/agents/
.github/hooks/

# ---------- Root-level litter guards ----------
# The Fluid Functionalism CLI dumps .tsx kit files into the repo root.
# Real kit code lives under src/ — never accept a component file at the root.
/*.tsx

# Screenshots and design exports belong in docs/screenshots/ (see its README).
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.svg
/*.pdf

# Font binaries belong in public/fonts/ (served) or docs/assets/fonts/ (source).
/*.otf
/*.ttf
/*.woff
/*.woff2
